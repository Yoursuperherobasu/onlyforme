# MCP Service Configuration
# All variables use the MCP_SERVICE_ prefix

# API key for authenticating requests to this microservice
MCP_SERVICE_API_KEY=your-api-key-here

# Server settings
MCP_SERVICE_HOST=0.0.0.0
MCP_SERVICE_PORT=8002
MCP_SERVICE_LOG_LEVEL=info

# CORS origins (comma-separated)
MCP_SERVICE_CORS_ORIGINS=*

# MCP session management
MCP_SERVICE_SERVER_TIMEOUT=20
MCP_SERVICE_MAX_SESSIONS_PER_SERVER=10
MCP_SERVICE_SESSION_IDLE_TIMEOUT=400
MCP_SERVICE_SESSION_CLEANUP_INTERVAL=120

# Database URL (same coredb as the main backend)
MCP_SERVICE_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/coredb

# Fernet encryption key for secrets stored in mcp_registry
# Derived from WEBUI_SECRET_KEY using: SHA-256 hash -> base64url encode
MCP_SERVICE_ENCRYPTION_KEY=your-fernet-key-here
