# Guardrails Service Configuration

# API key for authenticating requests to this service
GUARDRAILS_SERVICE_API_KEY=agentcore-guardrails-svc-key-001

# Server settings
GUARDRAILS_SERVICE_HOST=0.0.0.0
GUARDRAILS_SERVICE_PORT=8003
GUARDRAILS_SERVICE_LOG_LEVEL=info

# CORS allowed origins (comma-separated, use * for all)
GUARDRAILS_SERVICE_CORS_ORIGINS=*

# PostgreSQL connection string (same coredb as backend)
GUARDRAILS_SERVICE_DATABASE_URL=postgresql+psycopg://postgres:12345@localhost:5432/coredb

# Fernet encryption key for decrypting API keys in model_registry
# Derived from WEBUI_SECRET_KEY (SHA-256 → base64url) — must match the main backend
GUARDRAILS_SERVICE_ENCRYPTION_KEY=your-secret-key-here
