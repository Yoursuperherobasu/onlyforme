# ============================================================
# Dockerfile.guardrails-service — NeMo Guardrails + Presidio
# Build context: repo root
# Usage: docker build -f Dockerfile.guardrails-service -t guardrails-service .
#
# NOTE: This image includes spaCy + en_core_web_lg (~500MB model).
#       Realistic minimum is ~800-900MB. To reduce further, switch
#       to en_core_web_sm (~12MB) in pyproject.toml if full NER
#       accuracy is not required.
# ============================================================

FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_COMPILE_BYTECODE=0

RUN pip install --no-cache-dir uv

WORKDIR /build
COPY agentcore/src/services/guardrails-service/pyproject.toml \
     agentcore/src/services/guardrails-service/uv.lock ./

RUN uv venv /opt/venv && \
    . /opt/venv/bin/activate && \
    uv sync --frozen --no-dev --no-install-project && \
    # Remove spaCy vocab vectors we don't need for NER-only
    find /opt/venv -path "*/en_core_web_lg/vocab/vectors" -exec rm -rf {} + 2>/dev/null; \
    find /opt/venv -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null; \
    find /opt/venv -type d \( -name "tests" -o -name "test" -o -name "docs" \) -exec rm -rf {} + 2>/dev/null; \
    find /opt/venv -type f \( -name "*.pyc" -o -name "*.pyo" -o -name "*.pyi" \) -delete 2>/dev/null; \
    true

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    VIRTUAL_ENV=/opt/venv

RUN apt-get update && \
    apt-get install -y --no-install-recommends libpq5 && \
    rm -rf /var/lib/apt/lists/* /tmp/*

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY agentcore/src/services/guardrails-service/app ./app

RUN find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null; true

RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 8005

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8005/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8005"]
